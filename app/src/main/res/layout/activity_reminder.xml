<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reminder_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/big_margin">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/reminder_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/big_margin"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        tools:text="Event title" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/reminder_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        android:gravity="center"
        android:textColor="#B3FFFFFF"
        android:textSize="16sp"
        tools:text="Tomorrow, 10:00 \u2013 11:00" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/reminder_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/medium_margin"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Sample Street 12, Springfield"
        tools:visibility="visible" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/reminder_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        android:gravity="center"
        android:paddingStart="@dimen/bigger_margin"
        android:paddingEnd="@dimen/bigger_margin"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Bring the documents and confirm the appointment"
        tools:visibility="visible" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/reminder_snooze_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/reminder_round_button"
            android:contentDescription="@string/snooze"
            android:gravity="center"
            android:text="@string/snooze_minus"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/reminder_snooze"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/medium_margin"
            android:layout_marginEnd="@dimen/medium_margin"
            android:background="@drawable/reminder_snooze_pill"
            android:minWidth="160dp"
            android:paddingStart="@dimen/bigger_margin"
            android:paddingEnd="@dimen/bigger_margin"
            android:text="@string/snooze"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/reminder_snooze_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/reminder_round_button"
            android:contentDescription="@string/snooze"
            android:gravity="center"
            android:text="@string/snooze_plus"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp" />

    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <org.fossify.calendar.views.StarDismissView
        android:id="@+id/reminder_star"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/reminder_dismiss_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_margin"
        android:text="@string/drag_star_to_dismiss"
        android:textColor="#80FFFFFF"
        android:textSize="14sp" />

</LinearLayout>
